{
  "name": "uam-app-api",
  "private": true,
  "version": "0.1.0",
  "description": "우리 아이 미술관 앱 API (B) — Node 22 + Express 4 + mysql2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "ops:staff": "tsx scripts/ops/staff.ts",
    "ops:key": "tsx scripts/ops/key.ts",
    "ops:purge-retry": "tsx scripts/ops/purge-retry.ts",
    "ops:eval-items": "tsx scripts/ops/eval-items.ts",
    "ops:feature": "tsx scripts/ops/feature.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "heic-decode": "^2.1.0",
    "multer": "^1.4.4",
    "mysql2": "^3.24.4",
    "nodemailer": "^6.10.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.3",
    "express-openapi-validator": "^5.6.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
